AI_LAB_SUPABASE_URL=https://YOUR_AI_LAB_PROJECT.supabase.co
AI_LAB_SUPABASE_SECRET_KEY=

# The original Hit Dot Clown leaderboard project. These are used only by the
# server-side /api/leaderboard function; never add the secret key to VITE_* vars.
LEADERBOARD_SUPABASE_URL=https://YOUR_LEADERBOARD_PROJECT.supabase.co
LEADERBOARD_SUPABASE_SECRET_KEY=

# Optional: set these to enable the consented leaderboard-link email.
PUBLIC_LEADERBOARD_URL=https://hitdotclown-leaderboard.vercel.app/
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Hit Dot Clown
